# Copy to `.env` for local development. `.env` is gitignored.
#
# Only needed to point `astro dev` at an adp-proxy running on your machine.
# Without it, dev uses the production endpoint from wrangler.toml's [vars],
# which is usually what you want — set this only when you are changing the
# proxy and the site together.
#
# adp-proxy binds loopback (config.yaml: listen 127.0.0.1:8124), and `astro dev`
# runs on the same machine, so this reaches it directly with no nginx involved.
ADP_GRAPHQL_URL=http://localhost:8124/graphql
