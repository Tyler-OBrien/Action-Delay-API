---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import type { Job } from '../../../models/cloudflare/job';
import SmartGraph from '../../components/graph/SmartGraph.js';
import ErrorGraph from '../../components/graph/ErrorGraph';
import SuccessRateGraphLazy from '../../components/graph/SuccessRateGraphLazy.js';
import JobDetailHeader from '../../components/JobDetailHeader.astro';
import JobLocationsTable from '../../components/JobLocationsTable.astro';

interface Props {
	internalJobName: string;
}

const { internalJobName } = Astro.params;

const jobResp = await fetch("https://delay.cloudflare.chaika.me/v2/jobs/" + internalJobName);
const job: Job = (await jobResp.json()).data;

const quickAnalyticsResponse = await fetch('https://delay.cloudflare.chaika.me/v1/quick/QuickAnalytics/' + (job.internalJobName ?? job.jobName));
let quickAnalyticsData = [];
if (quickAnalyticsResponse.ok) {
	quickAnalyticsData = await quickAnalyticsResponse.json();
}

const enc = job.internalJobName.replaceAll("/", "%2F");

// 24h success rate for the header chip. Gracefully omitted if the endpoint
// isn't available yet (pre-deploy) or returns no data.
let successRate: number | null = null;
try {
	const now = new Date();
	const dayAgo = new Date(now.getTime() - 24 * 60 * 60 * 1000);
	const srResp = await fetch(
		`https://delay.cloudflare.chaika.me/v2/jobs/${enc}/successrate` +
		`?StartDateTime=${dayAgo.toISOString()}&EndDateTime=${now.toISOString()}`
	);
	if (srResp.ok) {
		const sr = (await srResp.json())?.data;
		if (sr && sr.successRate != null) successRate = sr.successRate;
	}
} catch {
	// leave successRate null
}
---

<BaseLayout title={job?.jobName ?? ""} description={job?.jobDescription ?? ""}>
	<div class="stack gap-8">
		<header class="wrapper stack gap-3">
			<a class="back-link" href="/ai/"><Icon icon="arrow-left" />All Jobs</a>
			<Hero title={job?.jobName} align="start">
				<p>{job?.jobDescription}</p>
			</Hero>
			<JobDetailHeader job={job} stats={quickAnalyticsData} type="ai" successRate={successRate} />
		</header>

		<main class="wrapper stack gap-6">
			<div class="surface p-4">
				<SmartGraph endpoint={`v2/jobs/${enc}/analytics`} label={job.jobName} options={["MedianApiResponseLatency", "AvgApiResponseLatency", "MinApiResponseLatency", "MaxApiResponseLatency"]} defaultOption="MedianApiResponseLatency" client:only="preact"/>
			</div>

			<div class="surface p-2">
				<ErrorGraph endpoint={`v2/jobs/${enc}/erroranalytics`} label={job.jobName} client:only="preact"/>
			</div>

			<details id="success-rate" class="surface p-4" open>
				<summary class="cursor-pointer font-semibold text-lg">Success Rate</summary>
				<SuccessRateGraphLazy detailsId="success-rate" jobName={job.internalJobName} label={job.jobName} client:only="preact"/>
			</details>

			<JobLocationsTable jobName={job.internalJobName} />
		</main>
	</div>
</BaseLayout>

<style>
	.back-link {
		display: none;
	}

	@media (min-width: 50em) {
		.back-link {
			display: block;
			align-self: flex-start;
		}
	}
</style>
