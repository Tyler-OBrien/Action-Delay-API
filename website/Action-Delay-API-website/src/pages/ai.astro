---
import BaseLayout from '../layouts/BaseLayout.astro';

import JobDisplay from '../components/JobDisplay.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';
import CategorySection from '../components/CategorySection.astro';
import type { QuickStats } from '../../models/cloudflare/quickstat';
import type { Job } from '../../models/cloudflare/job';
import { groupJobs } from '../data/jobCategories';

const getJobs = async () => {
	return (await (await fetch("https://delay.cloudflare.chaika.me/v2/jobs/type/ai")).json()).data
}
var getJobsTask = getJobs()

const getAnalytics = async () => {
	return (await (await fetch("https://delay.cloudflare.chaika.me/v1/quick/QuickAnalytics/type/ai")).json());
}
var getAnalyticsTask = getAnalytics()

const jobs: Job[] = await getJobsTask;
const stats: QuickStats[] = await getAnalyticsTask;

const oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);

const activeJobs = jobs.filter(job => new Date(job.predictedRunTime) >= oneWeekAgo);
const groups = groupJobs(activeJobs, 'ai');
---

<BaseLayout
	title="Cloudflare AI Monitoring"
	description="See Cloudflare AI Monitoring Jobs"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Cloudflare AI Jobs"
				tagline="Monitoring the performance and errors of various Cloudflare Models. The inputs are random to avoid caching but roughly the same and we limit text LLMs to 100 output tokens. More data to be exposed in the future (like TPS)."
				align="start"
			>
				<a href="/ai/overview">Overview</a>
			</Hero>
			<input
				id="job-filter"
				type="text"
				placeholder="Filter jobs..."
				class="w-full max-w-sm px-4 py-2 border border-gray-300 rounded-lg text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"
			/>
			<div class="stack gap-4">
				{
					groups.map((group, index) => (
						<CategorySection
							name={group.name}
							count={group.jobs.length}
							open={index === 0}
						>
							<Grid>
								{group.jobs.map((job: Job) => (
									<li>
										<JobDisplay type="ai" job={job} stats={stats.filter(stat => stat.job_name.toLowerCase() == job.internalJobName)} />
									</li>
								))}
							</Grid>
						</CategorySection>
					))
				}
			</div>
			<script src="../scripts/job-filter.js"></script>
		</main>
	</div>
</BaseLayout>
