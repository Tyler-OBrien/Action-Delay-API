---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import JobDisplay from '../components/JobDisplay.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';
import type { QuickStats } from '../../models/cloudflare/quickstat';
import type { Job } from '../../models/cloudflare/job';
import ErrorGraph from '../components/graph/ErrorGraph';
import SmartGraph from '../components/graph/SmartGraph';


const getJobs = async () => {
	return (await (await fetch("https://delay.cloudflare.chaika.me/v2/jobs/type/ai")).json()).data
}
var getJobsTask = getJobs()

const getAnalytics = async () => {
	return (await (await fetch("https://delay.cloudflare.chaika.me/v1/quick/QuickAnalytics/type/ai")).json());
}
var getAnalyticsTask = getAnalytics()

const jobs: Job[] = await getJobsTask;
const stats: QuickStats[] = await getAnalyticsTask;

const oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);

const reorderedList = jobs
  .filter(job => new Date(job.predictedRunTime) >= oneWeekAgo)
  .sort((a, b) => {
    const aIsCloudflare = a.jobName.startsWith('cloudflare');
    const bIsCloudflare = b.jobName.startsWith('cloudflare');
    if (aIsCloudflare !== bIsCloudflare) return Number(bIsCloudflare) - Number(aIsCloudflare);
    return a.jobName.localeCompare(b.jobName);
  });


---

<BaseLayout
	title="Cloudflare AI Monitoring"
	description="See Cloudflare AI Monitoring Jobs"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Cloudflare AI Jobs"
				tagline="Monitoring the performance and errors of various Cloudflare Models. The inputs are random to avoid caching but roughly the same and we limit text LLMs to 100 output tokens. More data to be exposed in the future (like TPS)."
				align="start"
			>
			      <a href="/ai/overview">Overview</a>
			</Hero>
			<input
				id="job-filter"
				type="text"
				placeholder="Filter jobs..."
				class="w-full max-w-sm px-4 py-2 border border-gray-300 rounded-lg text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white mb-4"
			/>
			<script>
				document.getElementById('job-filter')?.addEventListener('input', function(e) {
					const q = (e.target as HTMLInputElement).value.toLowerCase();
					document.querySelectorAll('[id$="grid"]').forEach((card: Element) => {
						(card.parentElement as HTMLElement).style.display =
							card.id.toLowerCase().includes(q) ? '' : 'none';
					});
				});
			</script>
			<Grid>
				{
					reorderedList.map((job: Job) => (
						<li>
							<JobDisplay type="ai" job={job} stats={stats.filter(stat => stat.job_name.toLowerCase() == job.internalJobName)} />
						</li>
					))
				}
			</Grid>
		</main>

	</div>
</BaseLayout>
