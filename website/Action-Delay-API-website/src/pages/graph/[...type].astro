---
import SmartGraph from '../../components/graph/SmartGraph.js';
import MainHead from '../../components/MainHead.astro';
const label = Astro.url.searchParams.get('label') || 'Chart';
const options = Astro.url.searchParams.get('options')?.split(',').filter(Boolean);
---
<html lang="en">
    <head><MainHead title={`${label} | Action-Delay-API`} /></head>
    <body><main id="main-content" tabindex="-1" class="wrapper">
        <SmartGraph endpoint={Astro.url.searchParams.get('endpoint')} label={label} options={options} fullscreen={true} client:only="preact" />
    </main></body>
</html>
