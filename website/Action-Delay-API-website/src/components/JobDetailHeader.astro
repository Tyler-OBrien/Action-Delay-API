---
import { formatDuration as formatTime, durationParts as formatTimeReturnUnit, rawDuration } from '../lib/duration';
import type { Job } from '../../models/cloudflare/job';
import { jobHealth, dotClass } from '../data/jobHealth';
import Sparkline from './graph/Sparkline.jsx';

interface Props {
	job: Job;
	stats: any[];
	type: string;
	successRate?: number | null;
}

const { job, stats, type, successRate = null } = Astro.props;



let delayTxt = "";
let displayedMs: number | undefined;
let delayTxtUnit = "";
let pending = { className: "", textContent: "" };

// Parse quick analytics into median/peak values.
let peakPeriod, dailyMedian, getJobMedian, monthlyMedian, peakPeriodTxt, quarterlyMedian;
stats?.forEach((item: any) => {
	switch (item.period) {
		case "Last 1 Day":
			dailyMedian = formatTime(parseInt(item.median_run_length));
			if (item.median_run_length && parseInt(item.median_run_length) > 0)
				getJobMedian = parseInt(item.median_run_length);
			break;
		case "Last 30 Days":
			monthlyMedian = formatTime(parseInt(item.median_run_length));
			break;
		case "Last 90 Days":
			quarterlyMedian = formatTime(parseInt(item.median_run_length));
			break;
		default:
			peakPeriod = formatTime(parseInt(item.median_run_length));
			peakPeriodTxt = `From ${new Date(item.period + "Z").toLocaleTimeString()} - ${new Date(new Date(item.period + "Z").getTime() + parseInt(item.median_run_length)).toLocaleTimeString()}`;
	}
});

let runTimeToUse = job.currentRunTime;
if (job.currentRunStatus === "Deployed" || job.currentRunStatus === "Success") {
	if (job.internalJobName === "cron") {
		delayTxtUnit = "Last Event: " + formatTime(new Date().getTime() - new Date(job.currentRunTime).getTime()) + " ago";
	} else {
		[delayTxt, delayTxtUnit] = formatTimeReturnUnit(displayedMs = job.currentRunLengthMs);
	}
	pending.className = '';
	pending.textContent = '';
} else if (job.currentRunStatus === "Undeployed" && ((!getJobMedian || (job.currentRunLengthMs ?? 0) > getJobMedian * 1.2) && (job.currentRunLengthMs ?? 0) > 5000)) {
	[delayTxt, delayTxtUnit] = formatTimeReturnUnit(displayedMs = job.currentRunLengthMs);
	if ((!getJobMedian || ((job.currentRunLengthMs ?? 0) * 3) > getJobMedian) && (job.currentRunLengthMs ?? 0) > 30000) {
		pending.textContent = 'IN PROGRESS';
		pending.className = 'highlightRed';
	} else {
		pending.textContent = 'IN PROGRESS';
		pending.className = 'highlightYellow';
	}
} else if (job.currentRunStatus == "API_Error" && job.lastRunStatus == "API_Error") {
	delayTxt = 'CF API Error';
	delayTxtUnit = "";
	pending.textContent = 'CF API Error';
	pending.className = 'highlightRed';
} else if (job.currentRunStatus === "Failure") {
	delayTxt = 'Error';
	delayTxtUnit = "";
	pending.textContent = 'Error';
	pending.className = 'highlightRed';
} else {
	[delayTxt, delayTxtUnit] = formatTimeReturnUnit(displayedMs = job.lastRunLengthMs);
	pending.className = '';
	pending.textContent = '';
	runTimeToUse = job.lastRunTime;
}

const noLastUpdate = job.internalJobName === "cron";
const lastUpdatedTxt = formatTime(new Date().getTime() - new Date(runTimeToUse ?? '').getTime()) + " ago";

const health = jobHealth(job);
const dot = dotClass(health);
const sparkEndpoint = `v2/jobs/${job.internalJobName.replaceAll("/", "%2F")}/analytics`;
// Perf/AI jobs only record API latency (their run-length series is empty/zero).
const sparkMetric = type === "perf" || type === "ai" ? "MedianApiResponseLatency" : "MedianRunLength";
const predicted = job.predictedDelayLengthMs && job.predictedDelayLengthMs > 0
	? formatTimeReturnUnit(job.predictedDelayLengthMs).join(' ')
	: '';
---

<div class="surface px-5 py-4 flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
	<!-- Value + sparkline -->
	<div class="flex items-center gap-4 md:border-r md:border-gray-200 md:dark:border-gray-700 md:pr-6">
		<span class={`shrink-0 w-3 h-3 rounded-full ${dot}`} title={health}></span>
		<div class="min-w-0">
			<div id={`delayNumberOuter${job.internalJobName}`} class="leading-none">
				<span class="text-2xl md:text-3xl font-bold" tabindex="0" data-raw={displayedMs == null ? undefined : rawDuration(displayedMs)} id={`delayNumber${job.internalJobName}`}>{delayTxt}</span>
				<span class="text-base text-gray" id={`delayUnit${job.internalJobName}`}>{delayTxtUnit}</span>
				{type === "ai" && (
					<span class="inline-flex items-center justify-center w-4 h-4 ml-1 rounded-full border border-gray-400 text-gray-500 dark:text-gray-400 text-[10px] align-middle cursor-help" title="For 100 output tokens">?</span>
				)}
			</div>
			<div class={`${pending.className} text-xs mt-1 h-4`} id={`pending${job.internalJobName}`}>{pending.textContent}</div>
		</div>
		<div class="hidden sm:flex flex-col items-center w-32 shrink-0">
			<Sparkline endpoint={sparkEndpoint} metric={sparkMetric} health={health} days={7} client:visible />
		</div>
	</div>

	<!-- Stat chips -->
	<div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
		{noLastUpdate ? null : (
			<div class="flex flex-col">
				<span class="text-gray text-xs">Last Update</span>
				<span class="font-semibold" id={`lastUpdate${job.internalJobName}`}>{lastUpdatedTxt}</span>
			</div>
		)}
		{successRate != null && (
			<div class="flex flex-col">
				<span class="text-gray text-xs">Success (24h)</span>
				<span class="font-semibold">{successRate.toFixed(1)}%</span>
			</div>
		)}
		{dailyMedian && (
			<div class="flex flex-col">
				<span class="text-gray text-xs">1 Day</span>
				<span class="font-semibold" id={`median1d${job.internalJobName}`}>{dailyMedian}</span>
			</div>
		)}
		{monthlyMedian && (
			<div class="flex flex-col">
				<span class="text-gray text-xs">30 Days</span>
				<span class="font-semibold" id={`median30d${job.internalJobName}`}>{monthlyMedian}</span>
			</div>
		)}
		{quarterlyMedian && (
			<div class="flex flex-col">
				<span class="text-gray text-xs">90 Days</span>
				<span class="font-semibold" id={`median90d${job.internalJobName}`}>{quarterlyMedian}</span>
			</div>
		)}
		{peakPeriod && (
			<div class="flex flex-col">
				<span class="text-gray text-xs">24H Peak</span>
				<span class="font-semibold" id={`peak${job.internalJobName}`}>{peakPeriod}</span>
				<span class="text-gray text-[10px]" id={`peak-period${job.internalJobName}`}>{peakPeriodTxt}</span>
			</div>
		)}
		{predicted && (
			<div class="flex flex-col">
				<span class="text-gray text-xs">Predicted</span>
				<span class="font-semibold italic">~{predicted}</span>
			</div>
		)}
	</div>
</div>
