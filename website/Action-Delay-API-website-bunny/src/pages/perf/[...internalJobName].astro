---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import type { Job } from '../../../models/cloudflare/job';
import SmartGraph from '../../components/graph/SmartGraph.js';
import ErrorGraph from '../../components/graph/ErrorGraph';
import RegionGraphLazy from '../../components/graph/RegionGraphLazy.js';
import JobDetailHeader from '../../components/JobDetailHeader.astro';
import JobLocationsTable from '../../components/JobLocationsTable.astro';

interface Props {
	internalJobName: string;
}

const { internalJobName } = Astro.params;

const jobResp = await fetch("https://api.bunny.chaika.me/v2/jobs/" + internalJobName);
const job: Job = (await jobResp.json()).data;

const quickAnalyticsResponse = await fetch('https://api.bunny.chaika.me/v1/quick/QuickAnalytics/' + (job.internalJobName ?? job.jobName));
let quickAnalyticsData = [];
if (quickAnalyticsResponse.ok) {
	quickAnalyticsData = await quickAnalyticsResponse.json();
}

const enc = job.internalJobName;
---

<BaseLayout title={job?.jobName ?? ""} description={job?.jobDescription ?? ""}>
	<div class="stack gap-8">
		<header class="wrapper stack gap-3">
			<a class="back-link" href="/perf/"><Icon icon="arrow-left" />All Jobs</a>
			<Hero title={job?.jobName} align="start">
				<p>{job?.jobDescription}</p>
			</Hero>
			<JobDetailHeader job={job} stats={quickAnalyticsData} type="perf" />
		</header>

		<main class="wrapper stack gap-6">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				<div class="surface p-4">
					<SmartGraph endpoint={`v2/jobs/${enc}/analytics`} label={job.jobName} options={["MedianRunLength", "MinRunLength", "MaxRunLength", "AvgRunLength"]} client:only="preact"/>
				</div>
				<div class="surface p-4">
					<SmartGraph endpoint={`v2/jobs/${enc}/analytics`} label={job.jobName} options={["AvgApiResponseLatency", "MedianApiResponseLatency", "MinApiResponseLatency", "MaxApiResponseLatency"]} client:only="preact"/>
				</div>
			</div>

			<div class="surface p-2">
				<ErrorGraph endpoint={`v2/jobs/${enc}/erroranalytics`} label={job.jobName} client:only="preact"/>
			</div>

			<JobLocationsTable jobName={job.internalJobName} />

			<details id="region-breakdown" class="surface p-4" open>
				<summary class="cursor-pointer font-semibold text-lg">Regional Breakdown</summary>
				<RegionGraphLazy detailsId="region-breakdown" jobName={job.internalJobName} label={job.jobName} defaultMetric="MedianApiResponseLatency" client:only="preact"/>
			</details>

			<details class="surface p-4" open>
				<summary class="cursor-pointer font-semibold text-lg">Geographic Map</summary>
				<iframe id="jobmapiframe" src={`https://perfmap.cloudflare.chaika.me/?${job.internalJobName}`} width="100%" style="height: 70vh !important;" class="mt-3 rounded-lg"></iframe>
			</details>
		</main>
	</div>
</BaseLayout>

<style>
	.back-link {
		display: none;
	}

	@media (min-width: 50em) {
		.back-link {
			display: block;
			align-self: flex-start;
		}
	}
</style>
