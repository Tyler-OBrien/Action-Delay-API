---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import StatusDashboard from "../components/StatusDashboard.astro";

const sections = [
  { label: "Delay Jobs", href: "/delay/" },
  { label: "Performance", href: "/perf/" },
  { label: "Locations", href: "/locations/" },
];
---

<BaseLayout
  title="Action-Delay-API — Bunny Status"
  description="Live propagation-delay status for Bunny configuration changes, measured from 50+ edge locations worldwide."
>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero
        title="Bunny Status"
        tagline="Live propagation delay of Bunny configuration changes — DNS, Edge Rules, Edge Scripts and more — measured from 50+ edge locations worldwide. Click any item for a recent-delay graph."
        align="start"
      />

      <nav aria-label="Sections" class="overview-strip">
        {
          sections.map((s) => (
            <a href={s.href} class="overview-link">
              {s.label}
            </a>
          ))
        }
      </nav>

      <StatusDashboard />
    </main>
  </div>
</BaseLayout>

<style>
  .overview-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .overview-link {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.9rem;
    border-radius: 999rem;
    border: 1px solid var(--gray-800);
    background-color: var(--gray-999_40);
    color: var(--gray-100);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color var(--theme-transition),
      color var(--theme-transition),
      background-color var(--theme-transition);
  }

  .overview-link:hover {
    border-color: var(--accent-regular);
    color: var(--accent-regular);
  }
</style>
