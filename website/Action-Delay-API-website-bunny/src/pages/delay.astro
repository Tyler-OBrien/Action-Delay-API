---

import BaseLayout from "../layouts/BaseLayout.astro";

import JobDisplay from "../components/JobDisplay.astro";
import Hero from "../components/Hero.astro";
import Grid from "../components/Grid.astro";
import CategorySection from "../components/CategorySection.astro";
import type { QuickStats } from "../../models/cloudflare/quickstat";
import type { Job } from "../../models/cloudflare/job";
import type { OverallAnalytics } from "../../models/cloudflare/overallanalytics";
import type { Incident } from "../../models/types";
import { groupJobs } from "../data/jobCategories";

const getJobs = async () => {
  return (
    await (
      await fetch(
        "https://api.bunny.chaika.me/v2/jobs/type/BunnyDelay"
      )
    ).json()
  ).data;
};

const getAnalytics = async () => {
  return await (
    await fetch(
      "https://api.bunny.chaika.me/v1/quick/QuickAnalytics/type/BunnyDelay"
    )
  ).json();
};

const getOverallAnalytics = async (): Promise<OverallAnalytics | null> => {
  try {
    const r = await fetch("https://api.bunny.chaika.me/v2/jobs/OverallAnalytics");
    if (!r.ok) return null;
    const json = await r.json();
    return json.data ?? json;
  } catch { return null; }
};

const getIncidents = async (): Promise<Incident[]> => {
  try {
    const r = await fetch("https://api.bunny.chaika.me/v2/incidents/type/BunnyDelay");
    return r.ok ? ((await r.json()).data ?? []) : [];
  } catch { return []; }
};

const [jobs, stats, overall, incidents]: [Job[], QuickStats[], OverallAnalytics | null, Incident[]] = await Promise.all([
  getJobs(), getAnalytics(), getOverallAnalytics(), getIncidents()
]);

const groups = groupJobs(jobs, "delay");

// Flatten (visible, grouped) jobs for the live-update script.
const visibleJobs = groups.flatMap((g) => g.jobs);

const hasIncident = (job: Job) =>
  incidents.some((i) => i.target === job.internalJobName && i.active);

// A delay category is "degraded" if any member has an active incident,
// an API error, or is currently marked delayed.
const groupIssue = (groupJobsList: Job[]) =>
  groupJobsList.some(
    (j) => hasIncident(j) || j.predictedRunStatus === "API_Error" || j.type === "delayed"
  );
---
<script define:vars={{ visibleJobs, stats }}>
globalThis.jobData = visibleJobs;
globalThis.jobStats = stats;
</script>
<BaseLayout
  title="Bunny Delay Monitoring"
  description="See Bunny Delay Monitoring Jobs"
>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero
        title="Bunny Delay Jobs"
        tagline="See the delay between an action being performed (DNS Update, Worker Update, etc) and it being visible on edge from 50+ locations worldwide."
        align="start"
      >
      <a href="/delay/overview">Overview</a>
      </Hero>
      <a id="websocket-conn-status">Disconnected</a>
      {overall && (
        <div class="flex flex-wrap gap-6 justify-center text-sm py-2 border-t border-b border-gray-200 dark:border-gray-700">
          <span><strong class="text-gray-900 dark:text-white">{overall.uniqueJobs}</strong> delay jobs</span>
          <span><strong class="text-gray-900 dark:text-white">{overall.uniqueLocations}</strong> locations</span>
          <span><strong class="text-gray-900 dark:text-white">{(overall.normalJobPerLocationRunsLast24H ?? 0).toLocaleString()}</strong> location-runs in last 24h</span>
        </div>
      )}
      <input
        id="job-filter"
        type="text"
        placeholder="Filter jobs..."
        class="w-full max-w-sm px-4 py-2 border border-gray-300 rounded-lg text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"
      />
      <div class="stack gap-4">
        {
          groups.map((group) => (
            <CategorySection
              name={group.name}
              count={group.jobs.length}
              statusColor={groupIssue(group.jobs) ? "bg-yellow-500" : "bg-green-500"}
              open={true}
            >
              <Grid>
                {group.jobs.map((job: Job) => (
                  <li>
                    <JobDisplay
                      type="job"
                      job={job}
                      stats={stats.filter(
                        (stat) => stat.job_name.toLowerCase() == job.internalJobName
                      )}
                      hasIncident={hasIncident(job)}
                    />
                  </li>
                ))}
              </Grid>
            </CategorySection>
          ))
        }
      </div>
      <script src="../scripts/job-filter.js"></script>
      <script src="/assets/js/8.0.7/signalr.min.js" is:inline> </script>
      <script src="/assets/js/8.0.7/signalr-protocol-msgpack.min.js" is:inline> </script>
      <script src="../scripts/signalr-delay-code.js"> </script>

    </main>
  </div>
</BaseLayout>
